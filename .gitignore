# Prevents OS auto-generated thumbnail cache from polluting commits and causing binary conflicts
Thumbs.db

# Prevents local Windows folder view preferences from cluttering the repository
desktop.ini

# Prevents macOS directory view metadata from leaking into shared commits
.DS_Store

# Prevents machine-specific macOS search indexing cache from being committed
.Spotlight-V100

# Prevents local OS recycle bin references from entering version control
.Trashes

# Avoids forcing personal VS Code extensions, window state, and UI settings onto other contributors
.vscode/

# Avoids committing JetBrains workspace state and machine-specific file paths
.idea/

# Prevents temporary editor lock and crash-recovery files from being tracked
*.swp

# Prevents automatic text editor backup files created on save from cluttering history
*~

# Prevents catastrophic leaks of Discord bot tokens, webhook secrets, and API keys to GitHub
.env

# Prevents staging or production secret overrides from being publicly exposed
.env.*
!.env.example

# Prevents publishing private cryptographic keys and server SSH credentials
*.key

# Prevents publishing sensitive security certificates and authentication tokens
*.pem

# Avoids committing auto-generated bytecode that bloats Git with machine-specific binaries
__pycache__/

# Prevents individual compiled Python files from creating useless binary diffs
*.pyc

# Avoids massive repository bloat from external packages that can be reinstalled anytime
node_modules/

# Keeps temporary runtime error dumps, audit trails, and debug outputs out of version control
*.log
